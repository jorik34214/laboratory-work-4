@startuml
left to right direction
skinparam packageStyle rectangle

actor "Пацієнт" as Patient
actor "Фізичний терапевт" as Therapist
actor "Система комп'ютерного зору (Camera API)" as VisionAPI

rectangle "GaitRecovery Vision (ПП)" {
  usecase "Реєстрація та авторизація" as UC1
  usecase "Налаштування профілю реабілітації" as UC2
  usecase "Виконання вправ на відновлення ходи" as UC3
  usecase "Аналіз поз і кроків через камеру" as UC4
  usecase "Отримання звукового/візуального попередження" as UC5
  usecase "Перегляд статистики прогресу" as UC6
  usecase "Призначення комплексу вправ" as UC7
  usecase "Моніторинг звітів пацієнта" as UC8

  UC3 .> UC4 : <<include>>
  UC4 .> UC5 : <<include>>
  UC3 <. UC5 : <<extend>>
  UC7 .> UC2 : <<include>>
}

Patient --> UC1
Patient --> UC2
Patient --> UC3
Patient --> UC6

Therapist --> UC1
Therapist --> UC7
Therapist --> UC8

VisionAPI --> UC4
@enduml
